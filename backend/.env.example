PORT=3040

# Local: Docker Mongo on host port 3043 (docker-compose overrides this inside the container)
MONGO_URI=mongodb://127.0.0.1:3043/Db_for_dsstyle

# Local URLs (production: https://api.DSSTYLE-DOMAIN, https://DSSTYLE-DOMAIN, https://admin.DSSTYLE-DOMAIN)
BACKEND_URL=http://localhost:3040
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

DB_USER=

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

# Telegram bot
Bot_UserName=
TELEGRAM_BOT_USERNAME=
Bot_Token=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Customer support chat (bot "Contact Seller" buttons)
SUPPORT_TELEGRAM_URL=https://t.me/Dsstyle1
