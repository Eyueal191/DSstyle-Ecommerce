# =================================================================
# Admin dashboard - PRODUCTION (used by `npm run build`, e.g. on Vercel)
# https://admin-dsstyle.endmartaddis.com
# Only public values belong here: every VITE_* value ends up in the browser bundle.
# =================================================================

VITE_BACKEND_URL=https://api-dsstyle.endmartaddis.com

# Client Storefront URL
VITE_STORE_URL=https://dsstyle.endmartaddis.com

# Admin Portal Identity
VITE_STORE_NAME=DS Style
VITE_PORTAL_TITLE=DS Style Admin Dashboard

# Physical Shop & Contact
VITE_STORE_PHONE=0918 10 10 22
VITE_STORE_PHONE_CALL=+251918101022
VITE_STORE_BUILDING=Golagole 22
VITE_STORE_CITY_AREA=Golagole
VITE_STORE_FULL_ADDRESS=Golagole 22, Addis Ababa

# Social & Telegram Channels
VITE_TELEGRAM_LINK=https://t.me/DSstyles
VITE_TELEGRAM_HANDLE=@DSstyles
VITE_TELEGRAM_BOT_USERNAME=@DS_Style_bot
